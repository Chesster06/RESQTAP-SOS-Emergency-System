{
  "rules": {
    ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
    ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
    "broadcastNotifications": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    },
    "admin_user_deletions": {
      "$uid": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    },
    "admin_notification_requests": {
      "$requestId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    },
    "admin_tasks": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
    },
    "roomTombstones": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && ( (newData.exists() && root.child('userRooms').child(auth.uid).child($roomId).child('role').val() === 'creator') || (!newData.exists() && !root.child('rooms').child($roomId).child('creatorUid').exists()) )"
      }
    },
    "rooms": {
      "$roomId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || (!data.exists() && newData.child(\"creatorUid\").val() === auth.uid) || (data.child(\"creatorUid\").val() === auth.uid) || (!newData.exists() && (data.child(\"creatorUid\").val() === auth.uid || root.child(\"userRooms\").child(auth.uid).child($roomId).child(\"role\").val() === \"creator\")) )",
        "creatorUid": {
          ".write": "auth != null && ((!data.exists() && newData.isString() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid && newData.val() === auth.uid))"
        },
        "createdAt": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('creatorUid').val() === auth.uid"
        },
        "name": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('creatorUid').val() === auth.uid"
        },
        "updatedAt": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('creatorUid').val() === auth.uid"
        },
        "instanceId": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('creatorUid').val() === auth.uid"
        },
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($roomId).child('creatorUid').val() === auth.uid || root.child('userRooms').child(auth.uid).child($roomId).child('role').val() === 'creator' || newData.parent().child('creatorUid').val() === auth.uid)"
        },
        "forceLeave": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('rooms').child($roomId).child('creatorUid').val())",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === root.child('rooms').child($roomId).child('creatorUid').val())"
          }
        },
        "members": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || newData.parent().parent().child(\"creatorUid\").val() === auth.uid || root.child(\"rooms\").child($roomId).child(\"creatorUid\").val() === auth.uid || (root.child(\"rooms\").child($roomId).child(\"members\").child(auth.uid).exists() && (root.child(\"rooms\").child($roomId).child(\"settings\").child(\"allowMemberInvite\").val() === true || !root.child(\"rooms\").child($roomId).child(\"settings\").child(\"allowMemberInvite\").exists())) || (!newData.exists() && root.child(\"userRooms\").child(auth.uid).child($roomId).child(\"role\").val() === \"creator\"))",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','updatedAt','instanceId']) && newData.child('instanceId').val() === newData.parent().parent().child('instanceId').val())"
          }
        },
        "bells": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('roomTombstones').child($roomId).exists()",
          "$toUid": {
            ".write": "auth != null && (auth.uid === $toUid || (root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('roomTombstones').child($roomId).exists()))"
          }
        },
        "sosAlerts": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || (root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('roomTombstones').child($roomId).exists()))",
          "$alertId": {
            ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || data.child('senderUid').val() === auth.uid || data.child('fromUid').val() === auth.uid || (root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('roomTombstones').child($roomId).exists()))",
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || data.child('senderUid').val() === auth.uid || newData.child('senderUid').val() === auth.uid || (root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('roomTombstones').child($roomId).exists()))",
            ".validate": "newData.hasChildren(['alertId','senderUid','roomId','createdAt','status'])",
            "senderUid": {
              ".validate": "newData.isString() && (newData.val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
            },
            "roomId": {
              ".validate": "newData.isString() && newData.val() === $roomId"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'cancelled' || newData.val() === 'resolved')"
            }
          }
        },
        "messages": {
          ".indexOn": ["timestamp"],
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || root.child('rooms').child($roomId).child('creatorUid').val() === auth.uid || (root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('roomTombstones').child($roomId).exists()))",
          "$messageId": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || root.child('rooms').child($roomId).child('creatorUid').val() === auth.uid || (root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('roomTombstones').child($roomId).exists()))",
            ".validate": "!newData.exists() || (newData.hasChildren(['id','senderUid','text','timestamp']) && newData.child('senderUid').val() === auth.uid)"
          }
        },
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || root.child('rooms').child($roomId).child('creatorUid').val() === auth.uid || (root.child('rooms').child($roomId).child('members').child(auth.uid).exists() && !root.child('roomTombstones').child($roomId).exists()))"
      }
    },
    "supportChats": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        "messages": {
          ".indexOn": [
            "createdAt"
          ],
          "$messageId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['text','sender','senderUid','senderName','createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 2500 && newData.child('sender').isString() && newData.child('senderUid').isString() && ((newData.child('sender').val() === 'user' && newData.child('senderUid').val() === auth.uid) || (newData.child('sender').val() === 'admin' && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)) || (newData.child('sender').val() === 'system' && (newData.child('senderUid').val() === auth.uid || newData.child('senderUid').val() === 'system')) || ((newData.child('sender').val() === 'ai' || newData.child('sender').val() === 'assistant') && (newData.child('senderUid').val() === auth.uid || newData.child('senderUid').val() === 'ai_assistant'))))"
          }
        }
      }
    },
    "aiChats": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        "messages": {
          ".indexOn": [
            "createdAt"
          ],
          "$messageId": {
            ".validate": "!newData.exists() || (newData.hasChildren(['text','role','senderUid','senderName','createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 1200 && newData.child('role').isString() && (newData.child('role').val() === 'user' || newData.child('role').val() === 'assistant') && newData.child('senderUid').isString() && newData.child('senderUid').val() === auth.uid)"
          }
        }
      }
    },
    "incidentReports": {
      ".indexOn": [
        "createdAt",
        "status",
        "senderUid",
        "category"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
      "$reportId": {
        ".read": "auth != null && (!data.exists() || data.child('senderUid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && ((root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true) || (!data.exists() && newData.exists() && newData.child('senderUid').val() === auth.uid && newData.child('status').val() === 'new'))",
        ".validate": "!newData.exists() || (newData.hasChildren(['reportId','senderUid','category','createdAt','status']) && newData.child('reportId').isString() && newData.child('reportId').val() === $reportId && newData.child('senderUid').isString() && newData.child('category').isString() && (newData.child('category').val() === 'fire' || newData.child('category').val() === 'crime' || newData.child('category').val() === 'medical_aid' || newData.child('category').val() === 'humanitarian_aid' || newData.child('category').val() === 'sea_emergency') && newData.child('createdAt').isNumber() && newData.child('status').isString() && (newData.child('status').val() === 'new' || newData.child('status').val() === 'reviewing' || newData.child('status').val() === 'resolved' || newData.child('status').val() === 'rejected') && (!newData.child('details').exists() || (newData.child('details').isString() && newData.child('details').val().length <= 500)) && (!newData.child('latitude').exists() || newData.child('latitude').isNumber()) && (!newData.child('longitude').exists() || newData.child('longitude').isNumber()))"
      }
    },
    "users": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
      ".indexOn": [
        "publicId",
        "name",
        "email"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        "name":     { ".read": "auth != null" },
        "publicId": { ".read": "auth != null" },
        "photoUrl": { ".read": "auth != null" },
        "photoB64": { ".read": "auth != null" }
      }
    },
    "userRooms": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".indexOn": ["createdAt"],
        "$roomId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
        }
      }
    },
    "userFriends": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    },
    "friendRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || newData.child('senderUid').val() === auth.uid)"
      }
    },
    "sentRequests": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    },
    "userNotifications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || newData.child('fromUid').val() === auth.uid)"
      }
    },
    "publicIds": {
      "$publicId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || (!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (newData.val() === auth.uid || !newData.exists())))"
      }
    },
    "highlights": {
      ".read": "true",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
    },
    "userCalls": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || data.child('callerUid').val() === auth.uid || data.child('targetUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || (!data.exists() && newData.child('callerUid').val() === auth.uid) || data.child('callerUid').val() === auth.uid || data.child('targetUid').val() === auth.uid)"
      }
    },
    "registeredEmails": {
      "$sanitizedEmail": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true || (!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (newData.val() === auth.uid || !newData.exists())))"
      }
    },
    "adminCalls": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
    },
    "admin_audit_logs": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
    },
    "call_logs": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('admins').child(auth.uid).child('active').val() === true)"
    }
  }
}