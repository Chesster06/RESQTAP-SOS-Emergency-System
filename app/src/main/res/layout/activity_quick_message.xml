<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    tools:context=".QuickMessageActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="124dp"
        android:background="@drawable/bg_wave_header_pink"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_top_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_tts_header_icon"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24"
            android:tint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/text_to_speech_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_top_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/text_to_speech_subtitle"
            android:textColor="#E6FFFFFF"
            android:textSize="12.5sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_top_back"
            app:layout_constraintTop_toBottomOf="@id/title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:paddingBottom="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:id="@+id/voice_mode_switch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="start"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_voice_mode_shell"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/tab_tts"
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_voice_mode_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/tab_tts_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_volume_24"
                        android:tint="@color/white" />

                    <TextView
                        android:id="@+id/tab_tts_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="TTS"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_stt"
                    android:layout_width="92dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/tab_stt_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mic_24"
                        android:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tab_stt_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="STT"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tts_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tts_voice_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tts_hero_card"
                android:elevation="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_tts_speaker_badge">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_volume_24"
                            android:tint="@color/brand_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/text_to_speech_preview_label"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/text_to_speech_subtitle"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/tts_play_stage"
                    android:layout_width="252dp"
                    android:layout_height="252dp"
                    android:layout_marginTop="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/tts_play_ring_outer"
                        android:layout_width="252dp"
                        android:layout_height="252dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tts_play_ring_outer" />

                    <View
                        android:id="@+id/tts_play_ring_mid"
                        android:layout_width="212dp"
                        android:layout_height="212dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tts_play_ring_mid" />

                    <View
                        android:id="@+id/tts_play_ring_inner"
                        android:layout_width="176dp"
                        android:layout_height="176dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tts_play_ring_inner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_voice"
                        android:layout_width="164dp"
                        android:layout_height="164dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="164dp"
                        android:minHeight="164dp"
                        android:text="@string/text_to_speech_play"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/tts_header"
                        app:cornerRadius="82dp"
                        app:icon="@drawable/ic_play_24"
                        app:iconGravity="textTop"
                        app:iconPadding="8dp"
                        app:iconSize="34dp"
                        app:iconTint="@color/white"
                        app:rippleColor="@color/tts_play_ring_inner" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/tts_wave_panel"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tts_wave_panel">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/tts_wave_bar_1"
                            android:layout_width="5dp"
                            android:layout_height="18dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_tts_wave_accent" />

                        <View
                            android:id="@+id/tts_wave_bar_2"
                            android:layout_width="5dp"
                            android:layout_height="34dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_tts_wave_accent" />

                        <View
                            android:id="@+id/tts_wave_bar_3"
                            android:layout_width="5dp"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_tts_wave_accent" />

                        <View
                            android:id="@+id/tts_wave_bar_4"
                            android:layout_width="5dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_tts_wave_accent" />

                        <View
                            android:id="@+id/tts_wave_bar_5"
                            android:layout_width="5dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_tts_wave_accent" />

                        <View
                            android:id="@+id/tts_wave_bar_6"
                            android:layout_width="5dp"
                            android:layout_height="22dp"
                            android:layout_marginHorizontal="4dp"
                            android:background="@drawable/bg_tts_wave_accent" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/text_to_speech_play_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tts_composer_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tts_content_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_to_speech_voice_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tts_setting_chip">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_globe_24"
                            android:tint="@color/tts_wave_accent" />

                        <Spinner
                            android:id="@+id/language_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:entries="@array/tts_language_options"
                            android:paddingStart="40dp"
                            android:paddingEnd="42dp"
                            android:spinnerMode="dropdown" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_down_24"
                            android:tint="@color/text_secondary" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/speed_chip"
                        android:layout_width="118dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_tts_speed_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_speed_24"
                            android:tint="@color/text_secondary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/text_to_speech_speed"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/speed_value"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_tts_speed_value"
                            android:gravity="center"
                            android:minWidth="28dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:text="1x"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/text_to_speech_input_label"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/input_panel"
                    android:layout_width="match_parent"
                    android:layout_height="144dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_tts_text_box">

                    <EditText
                        android:id="@+id/tts_input"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:hint="@string/text_to_speech_hint"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:maxLines="6"
                        android:paddingStart="16dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="44dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/tts_disabled_text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tts_char_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="18dp"
                        android:text="0 / 500"
                        android:textColor="@color/tts_disabled_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="14dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_paste_text"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_tts_input_action"
                            android:contentDescription="@string/text_to_speech_paste"
                            android:padding="10dp"
                            android:src="@drawable/ic_clipboard_24"
                            android:tint="@color/text_secondary" />

                        <ImageButton
                            android:id="@+id/btn_clear_text"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_tts_input_action"
                            android:contentDescription="@string/text_to_speech_clear"
                            android:padding="10dp"
                            android:src="@drawable/ic_delete"
                            android:tint="@color/text_secondary" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_copy"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="@string/text_to_speech_copy"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:backgroundTint="@color/tts_action_surface"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_copy_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/action_save"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="@string/text_to_speech_save"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:backgroundTint="@color/tts_action_surface"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_download_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconSize="18dp"
                        app:iconTint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/text_to_speech_history_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/history_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/empty_history"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tts_history_card"
                android:gravity="center"
                android:text="@string/text_to_speech_history_empty"
                android:textColor="@color/tts_disabled_text"
                android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stt_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/stt_hero_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stt_hero_card"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/stt_state"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_stt_status_chip"
                        android:gravity="center"
                        android:minWidth="82dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/speech_to_text_ready"
                        android:textColor="@color/stt_status_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/speech_to_text_title"
                        android:textColor="@color/text_primary"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/speech_to_text_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <FrameLayout
                        android:id="@+id/stt_language_chip"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_tts_setting_chip">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_globe_24"
                            android:tint="@color/tts_wave_accent" />

                        <Spinner
                            android:id="@+id/stt_language_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:entries="@array/tts_language_options"
                            android:paddingStart="40dp"
                            android:paddingEnd="42dp"
                            android:spinnerMode="dropdown" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_down_24"
                            android:tint="@color/text_secondary" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/stt_record_stage"
                        android:layout_width="match_parent"
                        android:layout_height="252dp"
                        android:layout_marginTop="16dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <View
                            android:id="@+id/stt_record_ring_outer"
                            android:layout_width="252dp"
                            android:layout_height="252dp"
                            android:layout_gravity="center"
                            android:alpha="0.28"
                            android:background="@drawable/bg_stt_record_ring" />

                        <View
                            android:id="@+id/stt_record_ring_inner"
                            android:layout_width="212dp"
                            android:layout_height="212dp"
                            android:layout_gravity="center"
                            android:alpha="0.48"
                            android:background="@drawable/bg_stt_record_ring" />

                        <View
                            android:id="@+id/stt_record_ring_core"
                            android:layout_width="176dp"
                            android:layout_height="176dp"
                            android:layout_gravity="center"
                            android:alpha="0.72"
                            android:background="@drawable/bg_stt_record_ring" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_stt_hold"
                            android:layout_width="164dp"
                            android:layout_height="164dp"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="164dp"
                            android:minHeight="164dp"
                            android:text="@string/speech_to_text_hold"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/stt_record_core"
                            app:cornerRadius="82dp"
                            app:icon="@drawable/ic_mic_24"
                            app:iconGravity="textTop"
                            app:iconPadding="8dp"
                            app:iconSize="34dp"
                            app:iconTint="@color/white"
                            app:rippleColor="@color/tts_play_ring_inner" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/stt_wave_panel"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tts_wave_panel">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/stt_wave_bar_1"
                                android:layout_width="5dp"
                                android:layout_height="18dp"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_tts_wave_accent" />

                            <View
                                android:id="@+id/stt_wave_bar_2"
                                android:layout_width="5dp"
                                android:layout_height="34dp"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_tts_wave_accent" />

                            <View
                                android:id="@+id/stt_wave_bar_3"
                                android:layout_width="5dp"
                                android:layout_height="46dp"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_tts_wave_accent" />

                            <View
                                android:id="@+id/stt_wave_bar_4"
                                android:layout_width="5dp"
                                android:layout_height="28dp"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_tts_wave_accent" />

                            <View
                                android:id="@+id/stt_wave_bar_5"
                                android:layout_width="5dp"
                                android:layout_height="38dp"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_tts_wave_accent" />

                            <View
                                android:id="@+id/stt_wave_bar_6"
                                android:layout_width="5dp"
                                android:layout_height="20dp"
                                android:layout_marginHorizontal="4dp"
                                android:background="@drawable/bg_tts_wave_accent" />
                        </LinearLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/stt_realtime_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/speech_to_text_realtime"
                        android:textColor="@color/tts_disabled_text"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stt_transcript_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_stt_transcript_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/speech_to_text_transcript"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btn_stt_clear"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_tts_input_action"
                            android:contentDescription="@string/text_to_speech_clear"
                            android:padding="10dp"
                            android:src="@drawable/ic_delete"
                            android:tint="@color/text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/stt_output"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:minHeight="126dp"
                        android:text="@string/speech_to_text_placeholder"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_nav_glass"
        android:clipToOutline="true"
        android:elevation="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="0dp"
        android:translationZ="32dp"
        app:activeIndicatorLabelPadding="12dp"
        app:itemActiveIndicatorStyle="@style/Widget.ResQTap.BottomNav.ActiveIndicator"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemPaddingBottom="16dp"
        app:itemPaddingTop="12dp"
        app:itemRippleColor="@android:color/transparent"
        app:itemTextAppearanceActive="@style/TextAppearance.ResQTap.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.ResQTap.BottomNav.Inactive"
        app:itemTextColor="@color/bottom_nav_tint"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
