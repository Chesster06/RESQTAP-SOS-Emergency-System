<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".NearbyHospitalActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_fragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlay_ui"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="6dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/panel"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_back"
                    style="@style/Widget.ResQTap.MapControlButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/back"
                    android:scaleX="-1"
                    app:icon="@drawable/ic_chevron_right"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/nearby_hospital_title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toTopOf="@id/subtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btn_back"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxLines="1"
                    android:text="@string/nearby_hospital_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btn_back"
                    app:layout_constraintTop_toBottomOf="@id/title" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:id="@+id/scroll_category_filters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/search_card">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_all"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_all"
                    android:textColor="@color/text_primary"
                    app:chipIcon="@drawable/ic_category_all"
                    app:chipIconSize="18dp"
                    app:chipIconTint="@color/brand_primary"
                    app:chipCornerRadius="16dp"
                    app:chipBackgroundColor="@color/panel"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hospital"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_hospital"
                    android:textColor="@color/text_primary"
                    app:chipIcon="@drawable/logo_kkm"
                    app:chipIconSize="20dp"
                    app:chipIconTint="@null"
                    app:chipCornerRadius="16dp"
                    app:chipBackgroundColor="@color/panel"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_police"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_police"
                    android:textColor="@color/text_primary"
                    app:chipIcon="@drawable/logo_pdrm"
                    app:chipIconSize="20dp"
                    app:chipIconTint="@null"
                    app:chipCornerRadius="16dp"
                    app:chipBackgroundColor="@color/panel"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_fire"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_fire"
                    android:textColor="@color/text_primary"
                    app:chipIcon="@drawable/logo_bomba"
                    app:chipIconSize="20dp"
                    app:chipIconTint="@null"
                    app:chipCornerRadius="16dp"
                    app:chipBackgroundColor="@color/panel"
                    app:chipStrokeColor="@color/divider"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/map_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="100dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map_my_location"
                style="@style/Widget.ResQTap.MapControlButton.Primary"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="@string/map_my_location"
                app:icon="@drawable/ic_menu_location"
                app:iconPadding="0dp"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map_type"
                style="@style/Widget.ResQTap.MapControlButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="@string/map_toggle_type"
                app:icon="@drawable/ic_layers"
                app:iconPadding="0dp"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map_zoom_in"
                style="@style/Widget.ResQTap.MapControlButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="@string/map_zoom_in"
                app:icon="@drawable/ic_add"
                app:iconPadding="0dp"
                app:iconSize="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_map_zoom_out"
                style="@style/Widget.ResQTap.MapControlButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/map_zoom_out"
                app:icon="@drawable/ic_remove"
                app:iconPadding="0dp"
                app:iconSize="20dp" />
        </LinearLayout>

        <!-- Marker Callout Info Popup (Admin Dashboard / Leaflet Popup Style) -->
        <LinearLayout
            android:id="@+id/marker_callout_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone"
            android:elevation="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_marker_callout"
                android:layout_width="290dp"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="@color/panel"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- Header Row: Avatar/Logo + Name + Close Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Circular Logo with Border Ring -->
                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/callout_logo_ring"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="center"
                                app:cardCornerRadius="21dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="2.5dp"
                                app:strokeColor="@color/success_green"
                                app:cardBackgroundColor="#FFE4EE">

                                <ImageView
                                    android:id="@+id/callout_logo"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/logo_kkm" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Online indicator green dot at bottom right -->
                            <View
                                android:id="@+id/callout_online_dot"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="1dp"
                                android:layout_marginBottom="1dp"
                                android:background="@drawable/bg_online_dot" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/callout_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <!-- Close Button 'x' -->
                        <ImageView
                            android:id="@+id/callout_btn_close"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/close"
                            android:padding="4dp"
                            android:src="@drawable/ic_close_24"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp"
                        android:background="@color/divider" />

                    <!-- Status row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/marker_info_status_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/callout_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/marker_info_status_active"
                            android:textColor="@color/success_green"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Distance row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/marker_info_distance_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/callout_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Address row -->
                    <TextView
                        android:id="@+id/callout_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp"
                        android:layout_marginBottom="10dp" />

                    <!-- Get Directions Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/callout_btn_directions"
                        style="@style/Widget.ResQTap.FilledButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="@string/marker_info_directions"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_directions_24"
                        app:iconSize="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Downward triangle pointer directly pointing at marker tip -->
            <ImageView
                android:id="@+id/callout_pointer"
                android:layout_width="20dp"
                android:layout_height="10dp"
                android:layout_marginTop="-1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_callout_triangle" />

        </LinearLayout>

        <!-- In-App Direction Navigation Bottom Sheet (Full width, rounded top, docked at bottom edge) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_navigation_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/panel"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ResQTap.BottomSheetTopRounded"
            app:cardElevation="24dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="28dp">

                <!-- Handle bar -->
                <View
                    android:id="@+id/nav_sheet_handle"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_sheet_handle"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Left Category Icon -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nav_icon_card"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8F9FA"
                    app:strokeWidth="1dp"
                    app:strokeColor="#12000000"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/nav_sheet_handle">

                    <ImageView
                        android:id="@+id/nav_category_icon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo_kkm" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Center Info (ETA, Destination, Address) -->
                <LinearLayout
                    android:id="@+id/nav_info_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toEndOf="@id/nav_icon_card"
                    app:layout_constraintEnd_toStartOf="@id/nav_actions_layout"
                    app:layout_constraintTop_toTopOf="@id/nav_icon_card"
                    app:layout_constraintBottom_toBottomOf="@id/nav_icon_card">

                    <TextView
                        android:id="@+id/nav_eta_distance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/nav_calculating_route"
                        android:textColor="#4CAF50"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/nav_destination_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Emergency Service"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/nav_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="sans-serif"
                        android:text="Location Address"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Right Action Buttons (3D Toggle & Close) -->
                <LinearLayout
                    android:id="@+id/nav_actions_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/nav_icon_card"
                    app:layout_constraintBottom_toBottomOf="@id/nav_icon_card">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_toggle_3d"
                        style="@style/Widget.ResQTap.MapControlButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@string/nav_toggle_3d"
                        app:icon="@drawable/ic_route_overview"
                        app:iconPadding="0dp"
                        app:iconSize="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_close_navigation"
                        style="@style/Widget.ResQTap.MapControlButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/close"
                        app:icon="@drawable/ic_close_24"
                        app:iconTint="@color/text_secondary"
                        app:iconPadding="0dp"
                        app:iconSize="20dp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/panel"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="138dp"
        app:paddingBottomSystemWindowInsets="false"
        app:paddingTopSystemWindowInsets="false"
        app:gestureInsetBottomIgnored="true"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <View
                android:id="@+id/sheet_handle"
                android:layout_width="84dp"
                android:layout_height="5dp"
                android:background="#78838383"
                android:backgroundTint="#77838383"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_search_hospital"
                style="@style/Widget.ResQTap.FilledButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/nearby_hospital_search"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sheet_handle" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/nearby_hospital_loading"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_search_hospital" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hospital_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="16dp"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/status" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
