<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Cartoon Question Illustration -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="190dp"
        android:layout_height="190dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#00000000"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <ImageView
            android:id="@+id/iv_confirm_safe_illustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/img_dialog_stop_sos" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tv_confirm_safe_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/sending_alarm_confirm_safe_title"
        android:textColor="#FF111827"
        android:textSize="20sp"
        android:fontFamily="sans-serif-bold" />

    <!-- Dialog Description -->
    <TextView
        android:id="@+id/tv_confirm_safe_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="@string/sending_alarm_confirm_safe_desc"
        android:textColor="#FF6B7280"
        android:textSize="14sp" />

    <!-- Action Buttons Row (Side by side like reference image) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Negative / Keep Sending Button (Outline pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_safe_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/sending_alarm_dialog_continue_sos"
            android:textColor="#FF374151"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:strokeColor="#FFE5E7EB"
            app:strokeWidth="1.5dp" />

        <!-- Positive / Confirm Stop SOS Button (Vibrant red/pink pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_safe_stop"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:text="@string/sending_alarm_dialog_stop_sos"
            android:textColor="#FFFFFFFF"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-bold"
            app:backgroundTint="#FFF43F5E"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
