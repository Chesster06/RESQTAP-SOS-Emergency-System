<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ProfileActivity">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_profile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Header Container -->
            <FrameLayout
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_header"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="46dp">

                <!-- Top App Bar in Hero -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp">

                    <TextView
                        android:id="@+id/tv_header_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/bottom_nav_profile"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_logout_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_room_header_icon"
                        android:contentDescription="@string/logout"
                        android:padding="9dp"
                        android:src="@drawable/ic_leave"
                        app:tint="@color/white" />
                </RelativeLayout>

                <!-- Avatar & Identity Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Avatar with Edit Badge Overlay -->
                    <FrameLayout
                        android:id="@+id/avatar_wrapper"
                        android:layout_width="98dp"
                        android:layout_height="98dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profile_photo"
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_icon_circle_white"
                            android:contentDescription="@string/profile_photo"
                            android:padding="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_avatar"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ResQTap.Circle"
                            app:strokeColor="@color/white"
                            app:strokeWidth="2.5dp" />

                        <FrameLayout
                            android:id="@+id/btn_avatar_edit_badge"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/bg_avatar_edit_badge"
                            android:elevation="2dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/brand_primary" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- User Name -->
                    <TextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/profile_name_default"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Subtitle / Phone / UID -->
                    <TextView
                        android:id="@+id/tv_profile_subinfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#D9CFF0"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Unified Full-Width Profile Sheet Card (Seamless Curve Overlap) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menu_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="-28dp"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/panel"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.ResQTap.TopRoundedSheet"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- Action Menu Items -->
                    <include
                        android:id="@+id/item_personal"
                        layout="@layout/item_profile_menu" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider" />

                    <include
                        android:id="@+id/item_contacts"
                        layout="@layout/item_profile_menu" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider" />

                    <include
                        android:id="@+id/item_security"
                        layout="@layout/item_profile_menu" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider" />

                    <include
                        android:id="@+id/item_language"
                        layout="@layout/item_profile_menu" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider" />

                    <include
                        android:id="@+id/item_settings"
                        layout="@layout/item_profile_menu" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider" />

                    <include
                        android:id="@+id/item_help"
                        layout="@layout/item_profile_menu" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="52dp"
                        android:background="@color/divider" />

                    <include
                        android:id="@+id/item_about"
                        layout="@layout/item_profile_menu" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_nav_glass"
        android:clipToOutline="true"
        android:elevation="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="0dp"
        android:translationZ="32dp"
        app:activeIndicatorLabelPadding="12dp"
        app:itemActiveIndicatorStyle="@style/Widget.ResQTap.BottomNav.ActiveIndicator"
        app:itemIconSize="20dp"
        app:itemIconTint="@color/bottom_nav_tint"
        app:itemPaddingBottom="16dp"
        app:itemPaddingTop="12dp"
        app:itemRippleColor="@android:color/transparent"
        app:itemTextAppearanceActive="@style/TextAppearance.ResQTap.BottomNav.Active"
        app:itemTextAppearanceInactive="@style/TextAppearance.ResQTap.BottomNav.Inactive"
        app:itemTextColor="@color/bottom_nav_tint"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
