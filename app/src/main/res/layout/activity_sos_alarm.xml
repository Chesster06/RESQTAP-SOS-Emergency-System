<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sos_alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="28dp">


            <!-- Illustrated Siren Alarm in Gauge Dial Circle Backdrop (Matches screenshot) -->
            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_marginTop="24dp">

                <!-- Gauge Dial Static Base (Tracks, glow, 60 radial ticks) -->
                <ImageView
                    android:id="@+id/sos_alarm_dial_base"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:src="@drawable/bg_siren_dial_base" />

                <!-- Rotating / Filling Red Progress Arc (Fills from 0 to full 360 degrees based on alarm seconds) -->
                <com.example.resqtap.sos.CircularProgressView
                    android:id="@+id/circular_progress_dial"
                    android:layout_width="240dp"
                    android:layout_height="240dp" />

                <!-- Enlarged Siren Graphic, dead center inside dial -->
                <ImageView
                    android:id="@+id/sos_alarm_icon"
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_siren_alarm" />
            </FrameLayout>

            <!-- Main Heading: "Alert Received Coming Up!" (Matches screenshot) -->
            <TextView
                android:id="@+id/tv_sos_alarm_main_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/sos_alarm_alert_received_title"
                android:textColor="#FF0F172A"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <!-- Card Siapa Yang Trigger SOS Itu -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sos_sender_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFFFF"
                app:cardCornerRadius="20dp"
                app:strokeColor="#FFE2E8F0"
                app:strokeWidth="1.2dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- Header Row: Label & Active Emergency Badge -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="@string/sos_alarm_sender_label"
                        android:textColor="#FF94A3B8"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.08" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp"
                        android:background="#FFF1F5F9" />

                    <!-- Main Profile Row: Avatar + Name + Subtitles -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_sos_sender_avatar"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_avatar"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ResQTap.Circle"
                            app:strokeColor="#FFE60067"
                            app:strokeWidth="2dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_sos_alarm_sender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHESSTER"
                                android:textColor="#FF0F172A"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_sos_sender_room_info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                tools:text="Room: Family Safety"
                                android:textColor="#FF64748B"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_sos_sender_status_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/sos_alarm_needs_help"
                                android:textColor="#FFE60067"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Siren Status Text (Initially GONE, visible after snoozed) -->
            <TextView
                android:id="@+id/tv_sos_alarm_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sos_alarm_snoozed"
                android:textColor="#FF10B981"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="28dp" />

            <!-- Slide to Snooze Container (Matching requested pill slider at bottom) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_slide_container"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FF0B1220"
                app:cardCornerRadius="999dp"
                app:strokeColor="#33EF4444"
                app:strokeWidth="1dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Track Label -->
                    <TextView
                        android:id="@+id/tv_slide_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingStart="54dp"
                        android:paddingEnd="20dp"
                        android:text="@string/sos_alarm_slide_to_snooze"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01" />

                    <!-- Slide SeekBar -->
                    <SeekBar
                        android:id="@+id/sos_alarm_seek"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:progress="0"
                        android:max="100"
                        android:splitTrack="false"
                        android:thumbOffset="0dp"
                        android:thumb="@drawable/sos_seek_thumb"
                        android:progressTint="#00000000"
                        android:progressBackgroundTint="#00000000" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Post-Snooze Action Buttons (Initially GONE, revealed after sliding) -->
            <LinearLayout
                android:id="@+id/layout_snoozed_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_dismiss"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/sos_alarm_dismiss"
                    android:textColor="#FF0F172A"
                    app:strokeColor="#CBD5E1"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_view_map"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1.4"
                    android:layout_marginStart="8dp"
                    android:text="@string/sos_alarm_view_map"
                    android:textColor="#FFFFFFFF"
                    app:backgroundTint="#FFE11D48"
                    app:icon="@drawable/ic_menu_location"
                    app:iconTint="#FFFFFFFF"
                    app:cornerRadius="999dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
